# ==========================================
# Snap & Study Secrets Configuration Template
# ==========================================
# Copy this file to .streamlit/secrets.toml (remove .example) and insert your credentials.
# NEVER commit the actual secrets.toml to GitHub!

# --- Google Gemini AI ---
# Get your free API key at: https://aistudio.google.com
GEMINI_API_KEY = "your-gemini-api-key-here"
GEMINI_MODEL = "gemini-3.8-flash"

# --- Option A: Twilio WhatsApp ---
# Sign up at: https://www.twilio.com/try-twilio
# Console -> Account SID & Auth Token
TWILIO_ACCOUNT_SID = "your-twilio-account-sid-here"
TWILIO_AUTH_TOKEN = "your-twilio-auth-token-here"

# Twilio Sandbox WhatsApp number (default is whatsapp:+14155238886)
TWILIO_WHATSAPP_FROM = "whatsapp:+14155238886"

# Optional: WhatsApp Content Template SID (starts with HX...)
# If left blank or not set, Snap & Study will send via direct standard message.
TWILIO_CONTENT_SID = ""

# --- Option B: Telegram Bot ---
# Create a bot in 30 seconds by messaging @BotFather on Telegram.
# Telegram Bot API token (e.g. "123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ")
TELEGRAM_BOT_TOKEN = "your-telegram-bot-token-here"

# --- Option C: Email (SMTP) ---
# Send notes via Gmail or any standard SMTP server (Free & no third-party SMS costs)
# For Gmail: Use your email and a 16-character "App Password" (myaccount.google.com/apppasswords)
SMTP_SERVER = "smtp.gmail.com"
SMTP_PORT = 587
SMTP_EMAIL = "your-email@gmail.com"
SMTP_PASSWORD = "your-app-password-here"
SMTP_SENDER_NAME = "Snap & Study AI"
